---
import BaseLayout from './BaseLayout.astro';
import AppHeader from '../components/AppHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import ServiceMarquee from '../components/ServiceMarquee.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactSection from '../components/ContactSection.astro';
import AppFooter from '../components/AppFooter.astro';
import CallButton from '../components/CallButton.astro';
import { buildStructuredData } from '../data/structuredData';
import { noindex } from '../data/site';
import { defaultLocale, getDict, homePath, locales } from '../i18n';

const t = getDict(Astro.currentLocale);
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(homePath(t.lang));
const ogImage = abs(t.meta.ogImage);
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const jsonLd = buildStructuredData(t, site, canonical);
---

<BaseLayout title={t.meta.title} lang={t.lang} robots={robots}>
  <Fragment slot="head">
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {locales.map(l => (
      <link rel="alternate" hreflang={l} href={abs(homePath(l))} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(homePath(defaultLocale))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={t.ogLocale} />
    {locales
      .filter(l => l !== t.lang)
      .map(l => (
        <meta property="og:locale:alternate" content={getDict(l).ogLocale} />
      ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#top">
    {t.header.skip}
  </a>
  <AppHeader />
  <main id="top">
    <HeroSection />
    <ServiceMarquee />
    <ServicesSection />
    <ClientsSection />
    <PricingSection />
    <FaqSection />
    <ContactSection />
  </main>
  <AppFooter />
  <CallButton />

  <script>
    // Reveal-on-scroll for [data-reveal] blocks; styles live in global.css (.reveal)
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        entries => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-revealed');
            io.unobserve(e.target);
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el, i) => {
        if (el.getBoundingClientRect().top < window.innerHeight) return;
        el.classList.add('reveal');
        el.style.setProperty('--reveal-delay', `${(i % 4) * 80}ms`);
        io.observe(el);
      });
    }
  </script>
</BaseLayout>
