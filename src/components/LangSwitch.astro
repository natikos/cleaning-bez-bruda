---
import { getDict, homePath, locales } from '../i18n';

const t = getDict(Astro.currentLocale);
---

<nav class="lang" aria-label={t.header.langLabel}>
  {locales.map(l =>
    l === t.lang ? (
      <span class="lang__item lang__item--current" aria-current="page" title={getDict(l).switchName}>
        {getDict(l).switchLabel}
      </span>
    ) : (
      <a
        class="lang__item"
        href={homePath(l)}
        hreflang={l}
        lang={l}
        title={getDict(l).switchName}
        aria-label={getDict(l).switchName}
      >
        {getDict(l).switchLabel}
      </a>
    )
  )}
</nav>

<style>
  .lang {
    display: flex;
    flex: none;
    padding: 3px;
    border-radius: 999px;
    background: var(--grey);
    font: 800 13px/1 var(--font-body);
    letter-spacing: 0.04em;
  }
  .lang__item {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 38px;
    padding: 0 10px;
    border-radius: 999px;
    color: var(--grey-text);
  }
  a.lang__item:hover {
    color: var(--black);
    background: var(--white);
  }
  .lang__item--current {
    background: var(--black);
    color: var(--white);
  }
</style>
