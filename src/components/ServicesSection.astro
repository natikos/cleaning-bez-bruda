---
import { Image } from 'astro:assets';
import SectionBadge from './SectionBadge.astro';
import floor from '../assets/floor.jpg';
import carpet from '../assets/carpet-pad.jpg';
import equipment from '../assets/equipment.jpg';
import { getDict } from '../i18n';

const t = getDict(Astro.currentLocale);

// Visual settings per card, keyed by the service id from the dictionary
const looks = {
  floors: { theme: 'grey', img: floor, crop: { x: '45%', y: '55%', zoom: 1 }, tagTones: [undefined, undefined] },
  carpet: {
    theme: 'yellow',
    img: carpet,
    crop: { x: '45%', y: '50%', zoom: 1 },
    tagTones: ['dark', 'dark', undefined]
  },
  equipment: { theme: 'black', img: equipment, crop: { x: '45%', y: '50%', zoom: 1 }, tagTones: ['accent'] }
} as const;
const services = t.services.items.map(item => {
  const look = looks[item.id];
  return { ...look, ...item, tags: item.tags.map((label, j) => ({ label, tone: look.tagTones[j] })) };
});
---

<section id={t.ids.services} class="services" aria-labelledby="h-services">
  <div class="head section-head" data-reveal>
    <SectionBadge icon="sparkle">{t.services.badge}</SectionBadge>
    <h2 id="h-services" class="section-title">
      {t.services.title}
    </h2>
  </div>
  <div class="grid">
    {services.map(s => (
      <article class={`card card--${s.theme}`} data-reveal>
        <div class="card__media">
          <Image
            class="card__img"
            src={s.img}
            alt={s.alt}
            widths={[540, 720, 1080]}
            sizes="(min-width: 1200px) 330px, (min-width: 820px) 30vw, (min-width: 560px) 45vw, calc(100vw - 72px)"
            style={{
              'object-position': `${s.crop.x} ${s.crop.y}`,
              'transform-origin': `${s.crop.x} ${s.crop.y}`,
              '--zoom': s.crop.zoom
            }}
          />
        </div>
        <h3 class="card__title">{s.title}</h3>
        <p class="card__text">{s.text}</p>
        <div class="tags">
          {s.tags.map(tag => (
            <span class:list={['tag', tag.tone && `tag--${tag.tone}`]}>{tag.label}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .services {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter);
  }
  .head {
    margin-bottom: clamp(28px, 4vw, 48px);
    max-width: 720px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 20px;
  }

  .card {
    border-radius: 28px;
    padding: clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 50px rgba(11, 11, 11, 0.1);
  }
  .card--grey {
    background: var(--grey);
  }
  .card--yellow {
    background: var(--yellow-soft);
  }
  .card--black {
    background: var(--black);
    color: var(--white);
  }
  .card--black:hover {
    box-shadow: 0 24px 50px rgba(11, 11, 11, 0.18);
  }

  /* Same photoshoot on every card, so each one gets its own framing: full scene, face close-up, machine detail */
  .card__media {
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(var(--zoom, 1));
    transition: transform 0.6s;
  }
  .card:hover .card__img {
    transform: scale(calc(var(--zoom, 1) * 1.05));
  }
  .card__title {
    margin: 0;
    font: 700 clamp(20px, 2.2vw, 26px) / 1.2 var(--font-display);
    letter-spacing: -0.015em;
  }
  .card__text {
    margin: 0;
    font: 500 16px/1.6 var(--font-body);
    color: var(--grey-text);
    text-wrap: pretty;
  }
  .card--black .card__text {
    color: var(--grey-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }
  .tag {
    background: var(--white);
    border-radius: 999px;
    white-space: nowrap;
    padding: 8px 14px;
    font: 700 13px/1 var(--font-body);
  }
  .tag--dark {
    background: var(--black);
    color: var(--white);
  }
  .tag--accent {
    background: var(--yellow);
    color: var(--black);
  }
</style>
