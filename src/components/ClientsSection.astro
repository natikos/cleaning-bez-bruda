---
import SectionBadge from './SectionBadge.astro';
import { getDict } from '../i18n';

const t = getDict(Astro.currentLocale);
---

<section id={t.ids.clients} class="clients" aria-labelledby="h-clients">
  <div class="clients__shape" aria-hidden="true"></div>
  <div class="clients__inner">
    <div class="clients__head section-head" data-reveal>
      <SectionBadge tone="yellow">{t.clients.tag}</SectionBadge>
      <h2 id="h-clients" class="section-title">
        {t.clients.title}
      </h2>
    </div>
    <ul class="list" data-reveal>
      {t.clients.items.map((name, i) => (
        <li class="card">
          <span class="card__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="card__name">{name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clients {
    background: var(--black);
    color: var(--white);
    position: relative;
    overflow: hidden;
  }
  .clients__shape {
    position: absolute;
    top: 0;
    right: -40px;
    width: 220px;
    height: 100%;
    background: var(--yellow);
    clip-path: polygon(60% 0, 100% 0, 40% 100%, 0 100%);
    opacity: 0.95;
  }
  .clients__inner {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 36px);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    max-width: 1000px;
  }
  @media (max-width: 699px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 128px;
    border-radius: 20px;
    padding: clamp(16px, 4vw, 20px);
    background: var(--black-raised);
    border: 1px solid var(--black-hover);
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  /* The catch-all last card spans two columns so 7 items fill even rows (4+4 desktop, 2×4 mobile) */
  .card:last-child {
    grid-column: span 2;
  }
  .card:hover {
    background: var(--black-hover);
    border-color: var(--yellow);
  }
  .card__num {
    font: 700 13px/1 var(--font-display);
    color: var(--yellow);
  }
  .card__name {
    font: 700 clamp(15px, 4.2vw, 17px)/1.3 var(--font-body);
    text-wrap: balance;
    hyphens: auto;
    overflow-wrap: break-word;
  }
</style>
