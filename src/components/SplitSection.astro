---
// Hero-style two-column block: diagonal grey/yellow backdrop, `intro` on the left, `visual` on the right.
---

<div class="split">
  <div class="split__shape split__shape--grey" aria-hidden="true"></div>
  <div class="split__shape split__shape--yellow" aria-hidden="true"></div>
  <div class="split__inner">
    <div class="intro">
      <slot name="intro" />
    </div>
    <slot name="visual" />
  </div>
</div>

<style>
  .split {
    position: relative;
    overflow: hidden;
  }
  .split__shape {
    position: absolute;
    top: 0;
    height: 100%;
  }
  .split__shape--grey {
    right: 0;
    width: min(58vw, 760px);
    background: var(--grey);
    clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%);
  }
  .split__shape--yellow {
    right: min(30vw, 420px);
    width: min(16vw, 180px);
    background: var(--yellow);
    clip-path: polygon(70% 0, 100% 0, 30% 100%, 0 100%);
  }
  .split__inner {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(32px, 6vw, 80px) var(--gutter) clamp(44px, 6vw, 88px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }
  .intro :global(.intro__title) {
    margin: 0;
    font: 700 clamp(30px, 4.4vw, 56px) / 1.12 var(--font-display);
    letter-spacing: -0.025em;
  }
  .intro :global(.highlight) {
    background: linear-gradient(transparent 58%, var(--yellow) 58%, var(--yellow) 92%, transparent 92%);
  }
  .intro :global(.intro__text) {
    margin: 0;
    max-width: 540px;
    font: 500 clamp(16px, 1.6vw, 19px) / 1.55 var(--font-body);
    color: var(--grey-text);
    text-wrap: pretty;
  }
</style>
