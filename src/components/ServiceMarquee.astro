---
import { getDict } from '../i18n';

const items = getDict(Astro.currentLocale).marquee;
// Two copies for a seamless -50% loop; one copy must be wider than the viewport
const marquee = [...items, ...items];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {marquee.map(m => (
      <span class="marquee__item">{m}</span>
    ))}
  </div>
</div>

<style>
  .marquee {
    background: var(--black);
    color: var(--white);
    overflow: hidden;
    padding: 18px 0;
    transform: skewY(-1.5deg);
    /* pull up by the lift the skew gives the edges (~tan(1.5deg) * half the width) */
    margin: -1.4vw 0 10px;
    position: relative;
    z-index: 1;
    border-top: 4px solid var(--yellow);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: bb-marquee 34s linear infinite;
  }
  .marquee__item {
    --space: 22px;
    display: flex;
    align-items: center;
    gap: var(--space);
    padding: 0 var(--space);
    font: 700 clamp(15px, 1.6vw, 19px) / 1 var(--font-display);
    white-space: nowrap;
  }
  .marquee__item::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yellow);
    flex: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
