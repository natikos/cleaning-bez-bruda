---
interface Props {
  icon?: string;
  as?: 'div' | 'h1';
  tone?: 'dark' | 'yellow';
  id?: string;
}
const { icon, as: Tag = 'div', tone = 'dark', id } = Astro.props;
---

<Tag class:list={['badge', `badge--${tone}`, { 'badge--plain': !icon }]} id={id}>
  {icon && <img class="badge__icon" src={`/icons/${icon}.svg`} alt="" width="28" height="28" />}
  <slot />
</Tag>

<style>
  .badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    margin: 0;
    border-radius: 999px;
    padding: 5px 16px 5px 5px;
    font: 700 12px/1.3 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .badge--dark {
    background: var(--black);
    color: var(--white);
  }
  .badge--yellow {
    background: var(--yellow);
    color: var(--black);
  }
  .badge--plain {
    padding: 9px 16px;
  }
  .badge__icon {
    width: 28px;
    height: 28px;
    flex: none;
  }
</style>
