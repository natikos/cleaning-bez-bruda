---
interface Props {
  icon?: string
}
const { icon } = Astro.props
---

<div class="badge">
  {icon && <img class="badge__icon" src={`/icons/${icon}.svg`} alt="" width="28" height="28" />}<slot />
</div>

<style>
  .badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    background: var(--black);
    color: var(--white);
    border-radius: 999px;
    padding: 5px 16px 5px 5px;
    font: 700 12px/1 var(--font-body);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .badge__icon { width: 28px; height: 28px; flex: none; }
</style>
