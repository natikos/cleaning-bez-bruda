---
import SectionBadge from './SectionBadge.astro';
import SplitSection from './SplitSection.astro';
import LogoStage from './LogoStage.astro';
import { minPrice } from '../data/prices';
import { getDict } from '../i18n';

const t = getDict(Astro.currentLocale);
---

<section class="hero" aria-labelledby="h1">
  <SplitSection>
    <Fragment slot="intro">
      <SectionBadge as="h1" id="h1" icon="sparkle">
        {t.hero.h1}
      </SectionBadge>
      <p class="intro__title">
        <span class="highlight">{t.hero.titleAccent}</span>
        {t.hero.titleRest}
      </p>
      <p class="intro__text">{t.hero.text}</p>

      <ul class="facts">
        {t.hero.facts.map(f => (
          <li class="fact">
            <img class="fact__icon" src={`/icons/${f.icon}.svg`} alt="" width="33" height="33" />
            <span class="fact__body">
              <span class="fact__title">{f.title}</span>
              {f.sub && <span class="fact__sub">{f.sub}</span>}
            </span>
          </li>
        ))}
      </ul>
    </Fragment>

    <LogoStage slot="visual" alt={t.hero.logoAlt}>
      <div class="price-badge">
        <span class="price-badge__from">{t.hero.priceFrom}</span>
        <span class="price-badge__value">{minPrice}</span>
        <span class="price-badge__unit">{t.hero.unit}</span>
      </div>
    </LogoStage>
  </SplitSection>
</section>

<style>
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    font-size: 15px;
    align-self: stretch;
  }
  @media (max-width: 479px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
  .fact {
    display: flex;
    align-items: center;
    gap: 0.8em;
    background: var(--white);
    border-radius: 1.3em;
    padding: 0.9em 1.2em;
    box-shadow: 0 16px 40px rgba(11, 11, 11, 0.14);
  }
  .fact__icon {
    flex: none;
    width: 2.2em;
    height: 2.2em;
  }
  .fact__body {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
  }
  .fact__title {
    font: 800 1.15em/1.2 var(--font-body);
  }
  .fact__sub {
    font: 500 0.85em/1.2 var(--font-body);
    color: var(--grey-text);
  }

  /* Right column */
  .price-badge {
    position: absolute;
    right: 3%;
    top: 5%;
    width: 24%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--yellow);
    border: 0.3em solid var(--white);
    box-shadow: 0 16px 40px rgba(11, 11, 11, 0.18);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2em;
    transform: rotate(8deg);
    z-index: 3;
  }
  .price-badge__from {
    font: 600 0.9em/1 var(--font-body);
  }
  .price-badge__value {
    font: 800 2.2em/1 var(--font-display);
  }
  .price-badge__unit {
    font: 700 0.9em/1 var(--font-body);
  }
  /* On phones the stage is small, so the badge gets more room around its text */
  @media (max-width: 759px) {
    .price-badge {
      width: 28%;
    }
    .price-badge__value {
      font-size: 2em;
    }
  }
</style>
