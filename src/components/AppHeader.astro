---
import BrandLink from './BrandLink.astro';
import { phone } from '../data/contacts';
import MessengerLinks from './MessengerLinks.astro';
import { getDict } from '../i18n';

const t = getDict(Astro.currentLocale);
const nav = (['services', 'clients', 'prices', 'faq', 'contacts'] as const).map(key => ({
  href: `#${t.ids[key]}`,
  label: t.header.nav[key]
}));
---

<header class="header" data-header>
  <div class="header__inner">
    <BrandLink href="#top" />

    <nav class="nav" id="site-nav" aria-label={t.header.navLabel}>
      <ul class="nav__list">
        {nav.map(item => (
          <li>
            <a class="nav__link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav__extra">
        <a class="nav__call" href={phone.href}>
          <img src={phone.icon} alt="" width="18" height="18" />
          {phone.label}
        </a>
        <div class="nav__messengers">
          <MessengerLinks />
        </div>
      </div>
    </nav>

    <div class="actions">
      <div class="messengers">
        <MessengerLinks />
      </div>
      <a class="call" href={phone.href}>
        <img src={phone.icon} alt="" width="18" height="18" />
        <span>{phone.label}</span>
      </a>
      <button
        class="burger"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label={t.header.openMenu}
        data-open-label={t.header.openMenu}
        data-close-label={t.header.closeMenu}
      >
        <span class="burger__bar"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = header?.querySelector<HTMLButtonElement>('.burger');
  if (header && burger) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', (open ? burger.dataset.closeLabel : burger.dataset.openLabel) ?? '');
    };
    burger.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    header.querySelectorAll('.nav a').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        burger.focus();
      }
    });
    document.addEventListener('click', e => {
      if (header.hasAttribute('data-open') && !header.contains(e.target as Node)) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--grey);
  }
  .header__inner {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 10px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav__list {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 600 15px/1 var(--font-body);
  }
  .nav__link {
    display: block;
    padding: 8px 0;
  }
  .nav__extra {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .messengers {
    display: flex;
    gap: 8px;
  }

  .call {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--yellow);
    color: var(--black);
    border-radius: 999px;
    padding: 11px 18px;
    font: 800 15px/1 var(--font-body);
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .call:hover {
    background: var(--yellow-dark);
    transform: translateY(-1px);
  }
  .call span {
    white-space: nowrap;
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--grey);
    cursor: pointer;
    place-items: center;
    padding: 0;
    transition: background 0.2s;
  }
  .burger__bar,
  .burger__bar::before,
  .burger__bar::after {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--black);
    transition:
      transform 0.2s,
      background 0.2s;
  }
  [data-open] .burger {
    background: var(--yellow);
  }
  .burger__bar {
    position: relative;
  }
  .burger__bar::before,
  .burger__bar::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .burger__bar::before {
    top: -6px;
  }
  .burger__bar::after {
    top: 6px;
  }
  [data-open] .burger__bar {
    background: transparent;
  }
  [data-open] .burger__bar::before {
    transform: translateY(6px) rotate(45deg);
  }
  [data-open] .burger__bar::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Messenger icons only where there is room for them */
  @media (max-width: 1199px) {
    .messengers {
      display: none;
    }
  }

  /* Below 1024px the nav collapses into a dropdown menu */
  @media (max-width: 1023px) {
    .burger {
      display: grid;
    }
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 4px var(--gutter) 20px;
      background: var(--white);
      border-bottom: 1px solid var(--grey);
      box-shadow: 0 20px 36px rgba(11, 11, 11, 0.08);
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }
    [data-open] .nav {
      display: block;
    }
    .nav__list {
      flex-direction: column;
      gap: 0;
      font: 600 17px/1.2 var(--font-body);
    }
    .nav__link {
      padding: 15px 0;
      border-bottom: 1px solid var(--grey);
    }
    .nav__list li:last-child .nav__link {
      border-bottom: 0;
    }
    .nav__extra {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding-top: 8px;
    }
    .nav__call {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: var(--yellow);
      border-radius: 999px;
      padding: 14px 18px;
      font: 800 17px/1 var(--font-body);
    }
    .nav__messengers {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      --messenger-w: auto;
      --messenger-h: 46px;
      --messenger-radius: 14px;
    }
  }

  /* On phones the floating call button takes over */
  @media (max-width: 759px) {
    .call {
      display: none;
    }
  }
</style>
