---
import { phone } from '../data/contacts'
import { getDict } from '../i18n'

const t = getDict(Astro.currentLocale)
---

<div class="callbar">
  <a class="callbar__call" href={phone.href}>
    <img src="/icons/phone.svg" alt="" width="18" height="18" />
    {t.callbar.call}
  </a>
  <a class="callbar__quote" href={`#${t.ids.contacts}`}>{t.callbar.quote}</a>
</div>

<style>
  .callbar {
    display: none;
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 60;
    gap: 8px;
    background: var(--black);
    border-radius: 999px;
    padding: 6px;
    box-shadow: 0 14px 34px rgba(11, 11, 11, .3);
  }
  @media (max-width: 759px) {
    .callbar { display: flex; }
  }
  .callbar a {
    flex: 1;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font: 800 16px/1 var(--font-body);
  }
  .callbar__call { gap: 8px; background: var(--yellow); color: var(--black); }
  .callbar__quote { color: var(--white); border: 1.5px solid var(--grey-text); }
</style>
