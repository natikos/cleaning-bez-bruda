---
import { phone } from '../data/contacts';
import { getDict } from '../i18n';

const t = getDict(Astro.currentLocale);
---

<a class="call-fab" href={phone.href} data-hide-over={t.ids.contacts} aria-label={`${t.header.call}: ${phone.label}`}>
  <img src={phone.icon} alt="" width="24" height="24" />
</a>

<script>
  // Hide the button while the contact section (yellow, with its own call button) reaches the button's corner
  const fab = document.querySelector<HTMLElement>('.call-fab');
  const section = fab && document.getElementById(fab.dataset.hideOver ?? '');
  if (fab && section) {
    new IntersectionObserver(([entry]) => fab.toggleAttribute('data-hidden', entry!.isIntersecting), {
      rootMargin: '0px 0px -90px 0px'
    }).observe(section);
  }
</script>

<style>
  .call-fab {
    display: none;
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 60;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(248, 204, 11, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 8px 24px rgba(11, 11, 11, 0.2);
    place-items: center;
    transition:
      opacity 0.3s,
      visibility 0.3s;
  }
  .call-fab[data-hidden] {
    opacity: 0;
    visibility: hidden;
  }
  /* Same breakpoint where the header call button is hidden */
  @media (max-width: 759px) {
    .call-fab {
      display: grid;
    }
  }
</style>
