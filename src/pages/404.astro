---
// Served by the host for any unknown URL, so it is one page for every locale:
// Ukrainian is rendered, and the script below swaps in English under /en/.
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLink from '../components/BrandLink.astro';
import LogoStage from '../components/LogoStage.astro';
import SectionBadge from '../components/SectionBadge.astro';
import SplitSection from '../components/SplitSection.astro';
import { phone } from '../data/contacts';
import { en } from '../i18n/en';
import { uk } from '../i18n/uk';
import { homePath } from '../i18n';

const t = uk.notFound;
const enText = en.notFound;
---

<BaseLayout title={`404 — ${uk.brand.name}`} lang={uk.lang} robots="noindex">
  <header class="top">
    <BrandLink href={homePath(uk.lang)} data-home />
  </header>

  <main class="nf">
    <SplitSection>
      <Fragment slot="intro">
        <SectionBadge icon="sparkle">
          <span data-en={enText.badge}>{t.badge}</span>
        </SectionBadge>
        <h1 class="intro__title">
          <span class="highlight" data-en={enText.titleAccent}>
            {t.titleAccent}
          </span>
          <span data-en={enText.titleRest}>{t.titleRest}</span>
        </h1>
        <p class="intro__text" data-en={enText.text}>
          {t.text}
        </p>
        <div class="actions">
          <a class="btn btn--dark" href={homePath(uk.lang)} data-home data-en={enText.home}>
            {t.home}
          </a>
          <a class="btn btn--yellow" href={phone.href}>
            <img src={phone.icon} alt="" width="18" height="18" />
            {phone.label}
          </a>
        </div>
      </Fragment>

      <LogoStage slot="visual">
        <div class="code-badge" aria-hidden="true">
          404
        </div>
      </LogoStage>
    </SplitSection>
  </main>

  <script>
    if (location.pathname.startsWith('/en')) {
      document.documentElement.lang = 'en';
      document.querySelectorAll<HTMLElement>('[data-en]').forEach(el => {
        el.textContent = el.dataset.en!;
      });
      document.querySelectorAll<HTMLAnchorElement>('a[data-home]').forEach(a => (a.href = '/en/'));
    }
  </script>
</BaseLayout>

<style>
  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .top {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 10px var(--gutter);
    border-bottom: 1px solid var(--grey);
  }
  .nf {
    flex: 1;
    display: grid;
    align-items: center;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: 999px;
    padding: 14px 24px;
    font: 800 15px/1 var(--font-body);
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn--dark {
    background: var(--black);
    color: var(--white);
  }
  .btn--dark:hover {
    background: var(--black-hover);
    color: var(--white);
  }
  .btn--yellow {
    background: var(--yellow);
    color: var(--black);
  }
  .btn--yellow:hover {
    background: var(--yellow-dark);
    color: var(--black);
  }
  .code-badge {
    position: absolute;
    right: 3%;
    top: 5%;
    width: 28%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--yellow);
    border: 0.3em solid var(--white);
    box-shadow: 0 16px 40px rgba(11, 11, 11, 0.18);
    display: grid;
    place-items: center;
    transform: rotate(8deg);
    z-index: 3;
    font: 800 2.2em/1 var(--font-display);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.bubble),
    :global(.logo-circle) {
      animation: none;
    }
  }
</style>
